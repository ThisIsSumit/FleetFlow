# Development-only values. Copy to .env. Never commit .env.
POSTGRES_DB=fleetflow
POSTGRES_USER=fleetflow
POSTGRES_PASSWORD=change-me-dev-only
# >= 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# Grafana (http://localhost:3000)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-dev-only
# Demo data: set SEED_DEMO=true to create demo@fleetflow.dev, dispatcher@fleetflow.dev, admin@fleetflow.dev (fictional company).
# If DEMO_PASSWORD is empty a random password is generated and printed once in the backend log.
SEED_DEMO=false
DEMO_PASSWORD=demo-password-change-me
# Failure-simulation API (OWNER only). Development only.
DEV_TOOLS=false
# Raise for load tests only. Default protects order creation at 100 requests/minute/user.
RATE_LIMIT_ORDERS=100
APP_URL=http://localhost:5173

# Row-level security: the backend connects as the non-superuser role fleetflow_app (created by infrastructure/postgres/01-app-role.sh).
# Use a simple alphanumeric password. NOTE: the init script only runs on a FRESH database volume (docker compose down -v to re-create).
APP_DB_PASSWORD=change-me-app-role-dev-only

# Email. Default in compose is Mailpit (a local SMTP catcher, web UI http://localhost:8025). For real delivery point these at your SMTP provider.
MAIL_PROVIDER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=FleetFlow <no-reply@fleetflow.dev>

# Address search (Nominatim-compatible). The public server is for light development only: set a real contact in the User-Agent
# and use your own instance or a commercial provider in production. Restrict results with GEOCODER_COUNTRIES (comma-separated ISO codes, e.g. in).
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=FleetFlow/0.1 (contact: you@example.com)
GEOCODER_COUNTRIES=in
GEOCODER_MAX_PER_SECOND=1
